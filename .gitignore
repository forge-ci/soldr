# Repo-local CARGO_HOME cache (perf_local.py / Docker harnesses point
# CARGO_HOME at ./.cargo). The tracked `.cargo/config.toml` stays; only the
# downloaded/build caches are ignored so `git add -A` can never sweep them in.
/.cargo/registry/
/.cargo/git/
/.cargo/.global-cache
/.cargo/.package-cache
/.cargo/.package-cache-mutate
# cargo-audit / cargo-deny advisory databases under the same CARGO_HOME, written
# by the local gate's rust lane (zackees/ci.yml#166).
/.cargo/advisory-db
/.cargo/advisory-db..lock
/.cargo/advisory-dbs/

# Same caches, one level down. Every dylint crate carries its own
# `.cargo/config.toml` (it selects the `dylint-link` linker), and running its
# test suite fills that directory with a registry cache -- 141 MB for a single
# `cargo test` run, none of it ignored by the root-anchored rules above. The
# tracked `config.toml` stays; only the caches are ignored (soldr#2749).
dylints/*/.cargo/registry/
dylints/*/.cargo/git/
dylints/*/.cargo/.global-cache
dylints/*/.cargo/.package-cache
dylints/*/.cargo/.package-cache-mutate

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

