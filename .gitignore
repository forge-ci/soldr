# Claude local workspace/runtime files. Keep .claude/ itself trackable for shared
# skills, hooks, and other repo configuration.
.claude/scheduled_tasks.lock
.claude/workspaces/
.claude/worktrees/
.claude/settings.local.json
.claude/.credentials*

# clud project config/runtime state: track shared settings while keeping
# generated Docker harnesses, task ledgers, loops, and local overrides private.
.clud/*
!.clud/
!.clud/settings.json
.clud/settings.local.json

# Dependent-repo checkouts coordinated via the clud-extern-repos convention.
.extern-repos/

# `ci/perf_local.py` copies debug traces out of the Linux runner into
# `.perf-local/` inside the repository mount (see `--debug-trace`), and agents
# park scratch logs beside them. It is per-developer runtime output, never
# repository content.
.perf-local/

# nektos/act local workflow runs (soldr#3039): the local cache/artifact
# servers and the tee'd run logs are per-developer runtime output. `.actrc`
# itself IS repository content and stays tracked.
.act-cache/
.act-artifacts/
act-run-*.log

# `soldr dylint cook` takes an advisory workspace-source lock so two nightlies
# cannot be inside cargo-chef's in-place skeleton reconstruction at once. In a
# git checkout it lives under `.git/`, but each crate under `dylints/` is its
# own Cargo workspace with no `.git/` of its own, so the lock lands beside the
# manifest instead. It holds no state (soldr#3042).
.soldr-dylint-cook.lock
# zackees/ci.yml#196: the local gate's per-run worktree nonce
.gate-nonce

# soldr#3946: bosn fleet run dumps are run metadata, not source. Attestations
# are commit-message trailers and measurements belong in Actions artifacts or a
# side branch, so nothing written here is repository content.
/ci/fleet-evidence/
